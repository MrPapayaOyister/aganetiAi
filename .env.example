# ─────────────────────────────────────────────────────────────
# Aganeti AI — environment template. Copy to `.env` and fill in.
# Do NOT commit the real .env (it is gitignored).
# ─────────────────────────────────────────────────────────────

# ── Local LLM (llama.cpp, OpenAI-compatible) ──
# Smart model endpoint (used by the OpenAI client + LangGraph meshes).
# ── Inference: LiteLLM is the ONLY gateway ───────────────────
#   app -> LiteLLM (:4000) -> qwen-fast -> vLLM (:9002)
# Never point these at a model server directly: the gateway owns the API key,
# model routing and fallbacks. LLM_API_KEY is LiteLLM's general_settings.master_key.
LLM_BASE_URL=http://localhost:4000/v1
LLM_MODEL=qwen-fast
LLM_API_KEY=sk-...
LLM_TIMEOUT=120
# Filename of the smart GGUF inside ./models (llama.cpp loads shard 1 of a split).

# ── Vector DB ──
QDRANT_URL=http://localhost:6333

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
USER_1_TELEGRAM_ID=
USER_2_TELEGRAM_ID=
USER_1_NAME=
USER_2_NAME=

# ── Legacy email (Gmail IMAP/SMTP — superseded by OAuth, optional) ──
EMAIL_ACCOUNT=
APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_SERVER=imap.gmail.com

# ── Supabase (Auth + DB) ──────────────────────────────────────
# Create a project at https://supabase.com, then copy from:
# Project Settings → API → Project URL / Project API Keys
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...        # service_role key — keep secret, backend only
SUPABASE_JWT_SECRET=your-jwt-secret  # Project Settings → API → JWT Secret

# ── Provider OAuth: where the connect/callback flows redirect ─
# BACKEND_URL must be the PUBLIC origin the provider can reach; the callbacks are
# {BACKEND_URL}/auth/google/callback and {BACKEND_URL}/auth/microsoft/callback.
BACKEND_URL=https://your-host/api
FRONTEND_URL=https://your-host

# ── Google OAuth (Gmail + Calendar + Contacts) ───────────────
# OAuth 2.0 Web client at console.cloud.google.com → Credentials.
# Authorized redirect URI: {BACKEND_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft 365 OAuth (Graph: Outlook + Calendar + Contacts) ─
# App registration at portal.azure.com → App registrations:
#   Platform "Web", redirect URI {BACKEND_URL}/auth/microsoft/callback
#   Certificates & secrets → new client secret → M365_CLIENT_SECRET
#   Delegated Graph permissions: offline_access, User.Read, Mail.Read, Mail.Send,
#   Mail.ReadWrite, Calendars.ReadWrite, Contacts.Read
# M365_TENANT_ID=common requires the registration to be multi-tenant ("Accounts in
# any organizational directory"); otherwise use the tenant GUID.
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_TENANT_ID=common

# ── Token encryption at rest (Fernet, urlsafe-base64 32 bytes) ─
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=

# ── Dashboard origins (comma-separated, or * for dev) ────────
DASHBOARD_ORIGINS=https://34.158.137.18

# ── Token encryption key (for provider tokens at rest) ───────
TOKEN_ENCRYPTION_KEY=change-me-to-a-random-32-char-string

# ── Misc ──
COMPANY_NAME=
TTS_ENABLED=true

# ── Tier-1 (DGX) features ──
# Native function-calling (llama.cpp `tools` + --jinja) instead of [ACTION:{json}] tags.
NATIVE_TOOLS=true
# Action autonomy: assist (gate everything) | standard (tasks auto, comms→approval) | autonomous
AUTONOMY_LEVEL=standard
# Pre-load Whisper/TTS at startup so the first voice message doesn't freeze the bot.
PREWARM_MODELS=true
# Extra LLM call per turn to guess unstated to-dos (off by default; native tools cover it).
PASSIVE_TASK_DETECT=false
# Background workers (APScheduler jobs + Telegram bot). false = HTTP API only.
RUN_BACKGROUND=true
# RAG ingestion: how often (seconds) data_vault/ is rescanned into Qdrant.
RAG_WATCH_INTERVAL=300
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=60
# Voice STT. device: auto|cuda|cpu (auto tries CUDA, falls back to CPU).
# NOTE: GPU needs a CUDA-enabled ctranslate2 build; the pip wheel on aarch64 is
# CPU-only, so on the DGX this currently runs on CPU until ctranslate2-cuda is built.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE=auto
