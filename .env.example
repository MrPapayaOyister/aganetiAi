# ─────────────────────────────────────────────────────────────
# Aganeti AI — environment template. Copy to `.env` and fill in.
# Do NOT commit the real .env (it is gitignored).
# ─────────────────────────────────────────────────────────────

# ── Local LLM (llama.cpp, OpenAI-compatible) ──
# Smart model endpoint (used by the OpenAI client + LangGraph meshes).
LLM_BASE_URL=http://localhost:8080/v1
LLM_SMART_URL=http://localhost:8080
LLM_FAST_URL=http://localhost:8081
# Filename of the smart GGUF inside ./models (llama.cpp loads shard 1 of a split).
LLM_MODEL_PATH=qwen2.5-14b-instruct-q4_k_m-00001-of-00003.gguf

# ── Vector DB ──
QDRANT_URL=http://localhost:6333

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
USER_1_TELEGRAM_ID=
USER_2_TELEGRAM_ID=
USER_1_NAME=
USER_2_NAME=

# ── Microsoft 365 (Graph) ──
M365_CLIENT_ID=
M365_TENANT_ID=
M365_SCOPES=Mail.ReadWrite Mail.Send Calendars.ReadWrite offline_access User.Read
USER_1_M365_EMAIL=
USER_2_M365_EMAIL=

# ── Legacy email (Gmail IMAP/SMTP — superseded by M365, optional) ──
EMAIL_ACCOUNT=
APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_SERVER=imap.gmail.com

# ── Misc ──
COMPANY_NAME=
TTS_ENABLED=true
