# ── Secrets & credentials ──────────────────────────────────
.env
credentials.json
tokens/

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.pyc
superenv/
.venv/

# ── Runtime data ───────────────────────────────────────────
logs/
temp/
email_store/
email_drafts.json
frontend/email_drafts.json
data_vault/.ingest_state.json
*.log
*.db
*.db-shm
*.db-wal

# ── Models (large GGUF / ONNX files) ──────────────────────
models/
tts_models/*.onnx

# ── Qdrant vector storage (separated from the memory/ python package) ──
# NOTE: the memory/ PYTHON PACKAGE (store.py, long_term.py, query_rewriter.py,
# summarizer.py) is now TRACKED. Only Qdrant's on-disk storage and runtime
# session files are ignored.
qdrant_data/
memory/__pycache__/
memory/*.json
memory/collections/
memory/aliases/
memory/raft_state.json

# runtime / sensitive — never commit
*.bak
data_vault/*.json
memory/*/

# ── Production hardening: gaps found when auditing the first clean commit ──
# The plain names (.env, credentials.json, data_vault/*.json) are ignored above,
# but TIMESTAMPED BACKUP COPIES slipped past every rule and carry live secrets:
#   .env.bak.pre-litellm                       → client secrets + DB passwords
#   data_vault/provider_connections.json.bak.* → OAuth access/refresh tokens
# Match the backup suffix explicitly rather than trusting the base pattern.
.env.*
!.env.example
*.bak.*
data_vault/*.json.bak*

# Database dumps and archived token bundles — secret-bearing and large.
backups/

# Neo4j on-disk store (526 MB) — infrastructure state, not source.
neo4j/

# Generated artifacts: both are reproduced byte-identically by their scripts
# (generate_enterprise_documents.py / run_evals.py), so committing them adds
# churn without adding recoverability.
data_vault/enterprise_corpus/
reports/

# Dev-backend PID file and attribution journal (scripts/dev_backend.sh).
run/
