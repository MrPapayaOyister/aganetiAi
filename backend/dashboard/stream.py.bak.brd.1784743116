"""Dashboard SSE generator — the live one-by-one reveal engine.

Reuses agenticAi's LangGraph executor (graph.GRAPH) and Tool registry, scoped to the
5 dashboard tools, and translates node updates into SSE frames:
    token        — streamed assistant reply text
    tool_call    — a tool was invoked (drives the status line: "Creating chart…")
    chart_saved  — a save_chart/delete_chart tool COMPLETED successfully; the frontend
                   reconciles the grid via GET /dashboard/charts on this signal
    done         — final reply text
    error / [DONE]

This is a NEW module — it touches no shared file. The primary Assistant path is
unaffected; the dashboard agent only ever sees DASHBOARD_TOOL_NAMES.
"""
from __future__ import annotations

import json
import logging

from backend.orchestrator import graph
from backend.dashboard.tools import DASHBOARD_TOOL_NAMES

log = logging.getLogger("aganeti.dashboard")

# The chart tools that, on successful completion, should trigger a grid reconcile.
_RECONCILE_TOOLS = {"save_chart", "delete_chart"}


def system_prompt(board_id: str) -> str:
    board_line = (
        f'This dashboard board has id "{board_id}". Pass it verbatim as the board_id argument '
        f"to every save_chart call.\n" if board_id else ""
    )
    return (
        "You build a live data dashboard for Dar Al Ber Society staff by turning plain-language "
        "requests into charts. You are talking to non-technical charity staff.\n\n"
        "HOW YOU WORK:\n"
        "1. ALWAYS call get_database_schema FIRST, before writing any SQL — never guess table or "
        "column names.\n"
        "2. Explore with query_data if unsure, then call save_chart (ONE call per chart). A chart "
        "appears on screen the instant save_chart succeeds.\n"
        "3. When the user asks for 'a dashboard', 'all our data', or several things at once, make "
        "SEVERAL charts — one save_chart call each.\n\n"
        "4. FORECASTS/PREDICTIONS: you cannot compute a future value as a chart - instead build "
        "the monthly TREND chart(s) so the direction is visible, and say the trend shows where "
        "things are heading.\n\n"
        "THE DATA (real aid-request database):\n"
        "- Use the DataShare.* VIEWS and Analytics.* tables. The dbo.* tables return no rows — do "
        "not use them.\n"
        "- DataShare.VRequests: one row per aid request. Good columns: Category / ServiceType "
        "(Study Fees, Home Rent, Treatment Fees, Debt, …), RequestStatusName (Approved, Rejected, "
        "InProcess, Cancelled), SubmitDate (for trends by month).\n"
        "- DataShare.VRequestAttributes: applicant attributes. Good columns: State (this is the "
        "EMIRATE — Dubai, Ajman, RAK, Sharjah, UAQ), Gender, MaritalStatus, Nationality, Religion, "
        "and amounts RequiredAmountForAssistance / SuggestedAssistanceAmount.\n"
        "- EMIRATE hygiene: State has a few junk rows (blank, and stray numeric ids like "
        "1740993718). Whenever you GROUP BY State, add WHERE State IN ('Ajman', 'Dubai', "
        "'Ras Al-Khaimah', 'Sharjah', 'Umm Al Quwain') so only the five real emirates chart.\n"
        "- EXPENDITURE = granted aid = SuggestedAssistanceAmount (RequiredAmountForAssistance is "
        "the amount REQUESTED, not granted). Do NOT chart NetMonthlyIncome / CurrentSalary / "
        "TotalSourcesOfIncome — they hold corrupt values (huge and negative).\n"
        "- PERFORMANCE (important): NEVER select or reference the DurationInDays / DurationInHours / "
        "DurationInMinutes columns — they make the query scan a huge table and time out. For counts "
        "and sums, GROUP BY a category column and COUNT(*) or SUM(amount).\n"
        "- AMOUNTS are messy: when summing/averaging RequiredAmountForAssistance or "
        "SuggestedAssistanceAmount, filter to sensible values (> 0 AND <= 1000000).\n"
        "- Country is a single value (UAE) — do NOT chart by country; use Category, status, or "
        "State (emirate) instead. There is no year column beyond SubmitDate.\n\n"
        "WRITING CHART SQL:\n"
        "- For bar/line/pie: alias the label column AS x and the number AS y, e.g. "
        "SELECT Category AS x, COUNT(*) AS y FROM DataShare.VRequests {where} GROUP BY Category.\n"
        "- For kpi (a single big number): alias it AS value, e.g. "
        "SELECT COUNT(*) AS value FROM DataShare.VRequests {where}.\n"
        "- Always include the literal {where} right before any GROUP BY (or at the end). SELECT "
        "only — never write to the database.\n\n"
        + board_line +
        "REPLIES: keep them short, warm and plain — one sentence like 'Here's the breakdown of "
        "requests by category.' NEVER mention SQL, table names, column names or the word 'query' in "
        "your reply. Never make up a number — every number must come from a chart you saved. The "
        "first query may take a few seconds while the database wakes up; that's normal."
    )


def _init_state(user_id: str, message: str, board_id: str, history: list, model_key):
    msgs: list[dict] = [{"role": "system", "content": system_prompt(board_id)}]
    if history:
        msgs.extend(history)
    msgs.append({"role": "user", "content": message})
    return {
        "messages": msgs, "user_id": user_id, "agent_id": "dashboard",
        "allowed_tools": DASHBOARD_TOOL_NAMES, "step": 0, "awaiting": None,
        "model_key": model_key, "fallback_models": [], "has_image": False,
    }


async def stream_dashboard(user_id: str, message: str, board_id: str = "", model_key=None):
    """Async generator of SSE 'data:' lines for POST /dashboard/chat."""
    # Best-effort per-board short-term memory (same store the Assistant uses).
    history = []
    try:
        from backend.orchestrator import conversation as convo
        history = convo.load(user_id, board_id or "dashboard")
    except Exception:
        convo = None  # type: ignore

    state = _init_state(user_id, message, board_id, history, model_key)
    cfg = {"recursion_limit": 3 * graph.STEP_BUDGET}
    final_text = ""
    try:
        async for _mode, chunk in graph.GRAPH.astream(state, cfg, stream_mode=["updates"]):
            for _node, upd in chunk.items():
                if not upd:
                    continue
                for m in upd.get("messages", []):
                    role = m.get("role")
                    if role == "assistant":
                        for tc in (m.get("tool_calls") or []):
                            yield f'data: {json.dumps({"type": "tool_call", "name": tc["function"]["name"]})}\n\n'
                        content = m.get("content")
                        if content:
                            final_text = content
                            yield f'data: {json.dumps({"type": "token", "content": content})}\n\n'
                    elif role == "tool":
                        name = m.get("name", "")
                        content = str(m.get("content", ""))
                        if name in _RECONCILE_TOOLS and not content.startswith("error"):
                            yield f'data: {json.dumps({"type": "chart_saved", "name": name})}\n\n'
        # Persist the turn so follow-ups ("now add another") have context.
        try:
            if convo is not None:
                convo.append(user_id, board_id or "dashboard", "user", message)
                if final_text:
                    convo.append(user_id, board_id or "dashboard", "assistant", final_text)
        except Exception:
            pass
        yield f'data: {json.dumps({"type": "done", "final": final_text})}\n\n'
    except Exception as e:  # noqa: BLE001
        log.exception("dashboard stream failed")
        yield f'data: {json.dumps({"type": "error", "message": str(e)})}\n\n'
    yield "data: [DONE]\n\n"
