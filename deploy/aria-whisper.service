[Unit]
Description=Aria GPU STT (whisper.cpp CUDA server, GB10)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matrix
WorkingDirectory=/home/matrix/whisper.cpp
# Built with: cmake -B build -DGGML_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=121 \
#             -DCMAKE_BUILD_TYPE=Release && cmake --build build -j --target whisper-server
ExecStart=/home/matrix/whisper.cpp/build/bin/whisper-server \
  -m /home/matrix/whisper.cpp/models/ggml-base.en.bin \
  --host 127.0.0.1 --port 8090 -bs 1 --no-timestamps --convert
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
