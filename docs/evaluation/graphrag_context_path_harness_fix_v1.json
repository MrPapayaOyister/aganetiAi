{
  "experiment": "evaluation_harness_provider_path_fix",
  "version": "v1",
  "type": "harness correctness fix \u2014 NOT a tuning experiment",
  "production_changed": false,
  "defect": {
    "summary": "EvaluationRunner retrieved the graph twice. _stage_graph used RunnerConfig.graph_depth/graph_top_k and fed only trace.graph_* (metrics). The prompt was built from ContextBuilder's GraphProvider, which took top_k=8 from its own constructor default and depth from settings.GRAPH_RETRIEVAL_DEPTH. RunnerConfig.providers is None, so the runner never configured it.",
    "consequence": "graph_top_k / graph_depth sweeps moved the metrics while the prompt stayed byte-identical, so every end-to-end answer reading was 'no effect'."
  },
  "fix": {
    "file": "backend/evals/runner.py",
    "method": "EvaluationRunner._answer_path_providers() substitutes ONLY the graph provider into the registry's provider list, constructing a new GraphProvider(enabled=<registry value>, top_k=config.graph_top_k, depth=config.graph_depth). Returns None when the config already matches the registry, so default runs use the registry by identity and are unchanged by construction. The shared registry instance is never mutated; an explicit config.providers override is passed through.",
    "not_changed": [
      "graph ranking",
      "fusion",
      "budget",
      "resolver",
      "mention extraction",
      "Neo4j",
      "Qdrant",
      "dataset",
      "production settings"
    ]
  },
