# Vite frontend environment variables
# Copy to .env.local and fill in real values
# NEVER commit .env.local

# Supabase project URL + anon key (safe to expose — protected by RLS)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# API base URL — in production this is the VM nginx /api proxy
# In local dev: leave as /api (Vite proxy handles it → DGX)
VITE_API_BASE_URL=/api
