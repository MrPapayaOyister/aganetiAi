import os
import datetime
import time
from google.auth.transport.requests import Request
from google.oauth2.credentials import Credentials
from googleapiclient.discovery import build

from config.settings import TOKENS_DIR
TOKEN_PATH = os.path.join(str(TOKENS_DIR), "calendar_token.json")

# In-memory TTL cache — survives for the process lifetime, resets on server restart
# Per-user cache: key = user_id, value = (timestamp_float, agenda_string)
_agenda_cache: dict[str, tuple[float, str]] = {}
AGENDA_CACHE_TTL = 300  # 5 minutes in seconds

_events_cache: dict[str, tuple[float, list]] = {}
EVENTS_CACHE_TTL = 120  # 2 minutes — meeting prep needs fresher data than agenda

def authenticate_calendar():
    """
    Authenticates with the Google Calendar API using the stored OAuth token.
    Raises FileNotFoundError if the token file does not exist.
    """
    if not os.path.exists(TOKEN_PATH):
        raise FileNotFoundError("Calendar token not found. Run scripts/authorize_calendar.py first.")

    creds = Credentials.from_authorized_user_file(TOKEN_PATH)
    
    # If the credentials are expired and a refresh_token exists, refresh them.
    if creds and creds.expired and creds.refresh_token:
        creds.refresh(Request())

    return build("calendar", "v3", credentials=creds)

def get_todays_agenda(user_id: str) -> str:
    """
    Returns today's calendar agenda for user_id.
    Result is cached for AGENDA_CACHE_TTL seconds (5 minutes).
    Cache is per-user — user_1 and user_2 never share cached results.
    """
    now = time.time()

    # Check cache hit
    if user_id in _agenda_cache:
        cached_at, cached_result = _agenda_cache[user_id]
        if now - cached_at < AGENDA_CACHE_TTL:
            return cached_result  # Cache hit — no API call

    # Cache miss or expired — call the real implementation
    result = _fetch_todays_agenda(user_id)

    # Store in cache
    _agenda_cache[user_id] = (now, result)
    return result

def _fetch_todays_agenda(user_id: str) -> str:
    """
    Fetches the calendar events for today from 00:00:00 UTC to 23:59:59 UTC
    and formats them into a clean, human-readable string.
    """
    try:
        service = authenticate_calendar()

        # Compute time window for today in UTC
        today = datetime.datetime.now(datetime.timezone.utc).date()
        time_min = f"{today}T00:00:00Z"
        time_max = f"{today}T23:59:59Z"

        events_result = service.events().list(
            calendarId="primary",
            timeMin=time_min,
            timeMax=time_max,
            singleEvents=True,
            orderBy="startTime",
            maxResults=20
        ).execute()

        events = events_result.get("items", [])
        if not events:
            return "No events scheduled for today."

        lines = ["Today's Schedule:"]
        for event in events:
            title = event.get("summary", "No Title")
            start = event["start"].get("dateTime", event["start"].get("date"))
            location = event.get("location", "")
            meeting_link = event.get("hangoutLink", "")

            if not start:
                continue

            if "T" not in start:
                line = f"- All Day: {title}"
            else:
                try:
                    dt = datetime.datetime.fromisoformat(start.replace("Z", "+00:00"))
                    time_str = dt.strftime("%I:%M %p").lstrip("0")
                    line = f"- {time_str}: {title}"
                except Exception:
                    line = f"- All Day: {title}"

            if location:
                line += f" (Location: {location})"
            if meeting_link:
                line += f" (Google Meet: {meeting_link})"

            lines.append(line)

        lines.append("\nYou must use the schedule above to answer any user queries about their calendar, schedule, or events today.")
        return "\n".join(lines)

    except Exception as e:
        print(f"Error fetching today's agenda: {e}")
        return "No events scheduled for today."

def invalidate_agenda_cache(user_id: str = None) -> None:
    """
    Clears the agenda cache.
    If user_id is provided — clears only that user's cache entry.
    If user_id is None — clears the entire cache (all users).
    Called on: new Calendar event creation, manual refresh request.
    """
    if user_id:
        _agenda_cache.pop(user_id, None)
    else:
        _agenda_cache.clear()

def format_agenda_for_prompt(user_id: str = "user_1") -> str:
    """
    Formats today's agenda into a clean, human-readable string suitable
    for inclusion in the LLM's system prompt.
    Delegate to cached get_todays_agenda() to utilize TTL cache.
    """
    return get_todays_agenda(user_id)

def get_upcoming_events(user_id: str = "user_1") -> list:
    now = time.time()
    if user_id in _events_cache:
        cached_at, cached_result = _events_cache[user_id]
        if now - cached_at < EVENTS_CACHE_TTL:
            return cached_result
    result = _fetch_upcoming_events(user_id)
    _events_cache[user_id] = (now, result)
    return result

def _fetch_upcoming_events(user_id: str) -> list:
    try:
        service = authenticate_calendar()
        
        # Define 2-hour window in UTC
        now_dt = datetime.datetime.now(datetime.timezone.utc)
        time_min = now_dt.isoformat()
        time_max = (now_dt + datetime.timedelta(hours=2)).isoformat()

        events_result = service.events().list(
            calendarId="primary",
            timeMin=time_min,
            timeMax=time_max,
            singleEvents=True,
            orderBy="startTime",
            maxResults=10
        ).execute()

        events = events_result.get("items", [])
        upcoming = []

        for event in events:
            upcoming.append({
                "title": event.get("summary", "No Title"),
                "start": event["start"].get("dateTime", event["start"].get("date")),
                "end": event["end"].get("dateTime", event["end"].get("date")),
                "location": event.get("location", ""),
                "attendees": [a["email"] for a in event.get("attendees", [])],
                "meeting_link": event.get("hangoutLink", ""),
                "event_id": event["id"]
            })

        return upcoming

    except Exception as e:
        print(f"Error fetching upcoming events: {e}")
        return []
